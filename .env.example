# ==========================================
# Конфигурация Telegram-бота с Google Gemini
# ==========================================

# Токен вашего Telegram-бота (получить в @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администратора бота (узнать свой ID можно командой /myid в боте)
ADMIN_ID=123456789

# API-ключ Google Gemini (получить в https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourSecretGeminiApiKeyHere

# Модель Gemini для текстового чата
# Рекомендуемые актуальные: gemini-3.5-flash (быстрая), gemini-3.5-flash-lite (легковесная)
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_TEXT_MODEL=gemini-3.5-flash-lite

# Модель для генерации изображений через Google Imagen 3 (флагманская модель Google)
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Включить бесплатный генератор изображений (на случай, если в Google AI Studio не привязан биллинг и квота limit: 0)
ENABLE_FREE_IMAGE_FALLBACK=true

# Токен Hugging Face для бесплатной модели FLUX.1 (получить в https://huggingface.co/settings/tokens)
HF_TOKEN=hf_YourHuggingFaceTokenHere

# Таймаут на сетевые запросы к AI в секундах
REQUEST_TIMEOUT=60
